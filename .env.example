# Copy this file to `.env` and fill in values.
# Never commit `.env` (it is gitignored).

# ---------------------------
# Notion (scripts/ingest_notes.py)
# ---------------------------
NOTION_TOKEN=""
NOTION_DB_ID=""
TITLE_PROPERTY_NAME="Date"
NOTION_VERSION="2022-06-28"

# ---------------------------
# Jira (scripts/run_jira_mcp.ps1)
# Use either the JIRA_* variables OR the ATLASSIAN_* variables below.
# ---------------------------
JIRA_URL="https://<your-site>.atlassian.net"
JIRA_USERNAME="you@example.com"
JIRA_API_TOKEN=""

ATLASSIAN_SITE_NAME="<your-site>"
ATLASSIAN_USER_EMAIL="you@example.com"
ATLASSIAN_API_TOKEN=""

MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="llm_twin"
MONGODB_COLLECTION="documents"
MONGODB_CHUNKS_COLLECTION="chunks"

CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120
